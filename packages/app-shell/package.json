{
  "name": "@hilum/app-shell",
  "version": "4.5.0",
  "private": false,
  "description": "Composed product-app layouts — AppShell, AppSidebar, AppHeader, PageHeader, DetailScreen, SettingsScreen, SignInScreen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilum-labs/hilum-ui.git",
    "directory": "packages/app-shell"
  },
  "homepage": "https://ui.hilum.dev",
  "bugs": {
    "url": "https://github.com/hilum-labs/hilum-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@hilum/ui": "^4.0.0",
    "lucide-react": ">=0.511.0 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@hilum/ui": "workspace:*",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.542.0",
    "tailwindcss": "^4.2.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  }
}
