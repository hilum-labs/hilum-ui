{
  "name": "@hilum/ui",
  "version": "4.7.1",
  "private": false,
  "description": "Hilum UI — design system primitives (Button, Input, Dialog, Combobox, …) + tokens + fonts + icons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilum-labs/hilum-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://ui.hilum.dev",
  "bugs": {
    "url": "https://github.com/hilum-labs/hilum-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./vendor.css": "./dist/vendor.css",
    "./fonts/*": "./dist/fonts/*",
    "./create-theme": {
      "types": "./dist/create-theme.d.ts",
      "import": "./dist/create-theme.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./icon-libraries": {
      "types": "./dist/icon-libraries.d.ts",
      "import": "./dist/icon-libraries.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/components/*.tsx",
    "src/icons.ts",
    "src/icon-libraries.ts",
    "src/index.ts",
    "src/ai.ts",
    "src/form.tsx",
    "src/lib/*.ts",
    "src/lib/*.tsx",
    "src/hooks/*.ts",
    "src/hooks/*.tsx",
    "src/tokens/*.ts",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/build-tokens.mjs && node ./scripts/build-fonts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.44.0",
    "@untitledui/icons": "^0.0.22",
    "lucide-react": ">=0.511.0 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.0",
    "input-otp": "^1.4.2",
    "pdfjs-dist": "^6.1.200",
    "radix-ui": "^1.1.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/gabarito": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.44.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@untitledui/icons": "^0.0.22",
    "lucide-react": "^0.542.0",
    "react-hook-form": "^7.89.0",
    "tailwindcss": "^4.2.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@hugeicons/core-free-icons": {
      "optional": true
    },
    "@hugeicons/react": {
      "optional": true
    },
    "@phosphor-icons/react": {
      "optional": true
    },
    "@tabler/icons-react": {
      "optional": true
    },
    "@untitledui/icons": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  }
}
