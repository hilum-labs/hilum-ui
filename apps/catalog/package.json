{
  "name": "@hilum/catalog",
  "version": "0.1.1",
  "private": true,
  "description": "Hilum UI catalog — the live documentation site at ui.hilum.dev",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-docs-content.mjs && vite dev",
    "docs:generate": "node scripts/build-docs-content.mjs",
    "build": "node scripts/check-component-coverage.mjs && node scripts/build-registry.mjs && node scripts/build-docs-content.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/check-component-coverage.mjs && tsc --noEmit",
    "check:coverage": "node scripts/check-component-coverage.mjs",
    "lint": "eslint src scripts --max-warnings 0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hilum/app-shell": "workspace:*",
    "@hilum/designer": "workspace:*",
    "@hilum/designer-canvas": "workspace:*",
    "@hilum/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-router": "^1.170.7",
    "@tanstack/react-start": "^1.168.26",
    "@untitledui/icons": "^0.0.22",
    "lucide-react": "^0.542.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.10",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
